<?xml version="1.0"?>
<ruleset name="Autoparser">
	<description>WordPress Coding Standards ruleset for the Autoparser plugin.</description>

	<file>.</file>

	<exclude-pattern>/vendor/*</exclude-pattern>
	<exclude-pattern>/node_modules/*</exclude-pattern>
	<exclude-pattern>/assets/build/*</exclude-pattern>
	<exclude-pattern>/assets/src/*</exclude-pattern>
	<!-- PHPUnit tests follow PSR/PHPUnit conventions (camelCase test
	     methods, no WP runtime), not WordPress Coding Standards. -->
	<exclude-pattern>/tests/*</exclude-pattern>

	<arg value="sp"/>
	<arg name="basepath" value="."/>
	<arg name="colors"/>
	<arg name="extensions" value="php"/>

	<rule ref="WordPress">
		<!--
		Classes are autoloaded via Composer PSR-4 (see composer.json:
		"AutoParser\\": "src/"), so files are named after the class they
		contain (e.g. Logger.php), not the classic WordPress
		"class-{name}.php" convention this sniff expects. Renaming files
		to satisfy it would break autoloading.
		-->
		<exclude name="WordPress.Files.FileName"/>
	</rule>
</ruleset>
