{
  "name": "sc-autoparser",
  "version": "0.1.0",
  "description": "Admin React app for SC Autoparser WordPress plugin",
  "private": true,
  "scripts": {
    "start": "wp-scripts start --output-path=assets/build assets/src/index.js assets/style.scss",
    "build": "wp-scripts build --output-path=assets/build assets/src/index.js assets/style.scss",
    "format": "wp-scripts format",
    "lint:js": "wp-scripts lint-js",
    "lint:css": "stylelint '**/*.scss'"
  },
  "devDependencies": {
    "@wordpress/icons": "^10.22.0",
    "@wordpress/scripts": "^26.6.1",
    "autoprefixer": "^10.4.16",
    "postcss": "^8.4.28",
    "sass": "^1.70.0",
    "stylelint": "^15.0.0",
    "tailwindcss": "^3.4.4"
  },
  "browserslist": [
    "extends @wordpress/browserslist-config"
  ],
  "dependencies": {
    "framer-motion": "^12.9.4",
    "lucide-react": "^0.507.0"
  }
}
