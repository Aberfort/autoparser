{
  "name": "example/sc-autoparser",
  "description": "Automatic parser with Gemini AI rewrite & Gutenberg autoposting.",
  "type": "wordpress-plugin",
  "license": "GPL-2.0-or-later",
  "require": {
    "php": "^8.2",
    "pimple/pimple": "^v3.5.0",
    "symfony/dom-crawler": "^7.0",
    "symfony/browser-kit": "^7.0",
    "guzzlehttp/guzzle": "^7.8",
    "monolog/monolog": "^3.4",
    "gemini-api-php/client": "^1.7",
    "woocommerce/action-scheduler": "^3.9",
    "google-gemini-php/client": "^1.0",
    "symfony/css-selector": "^7.2",
    "openai-php/client": "^0.13.0"
  },
  "autoload": {
    "psr-4": {
      "ScAutoParser\\": "src/"
    }
  },
  "scripts": {
    "lint": "phpcs --standard=WordPress --extensions=php --ignore=vendor ./src",
    "lint-fix": "phpcbf --standard=WordPress --extensions=php --ignore=vendor ./src",
    "test": "vendor/bin/phpunit",
    "build": "wp-scripts build",
    "start": "wp-scripts start"
  },
  "config": {
    "platform": {
      "php": "8.2.0"
    },
    "allow-plugins": {
      "composer/installers": true,
      "php-http/discovery": true,
      "dealerdirect/phpcodesniffer-composer-installer": true
    }
  },
  "minimum-stability": "stable",
  "require-dev": {
    "wp-cli/wp-cli": "^2.8",
    "squizlabs/php_codesniffer": "^3.8",
    "wp-coding-standards/wpcs": "^3.1",
    "phpcsstandards/phpcsutils": "^1.0",
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
  }
}
